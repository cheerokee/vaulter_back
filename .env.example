# Copie para .env e ajuste. O .env não é versionado.

# Porta da API no host (docker-compose). Dentro do container a API sempre escuta na 3000.
API_PORT=3000

# PostgreSQL 18 + pgvector (serviço "db" do compose)
# Dentro dos containers o host é "db" na porta 5432; do host, use localhost:DB_EXTERNAL_PORT.
DB_HOST=db
DB_PORT=5432
DB_DATABASE=vaulter
DB_USERNAME=vaulter
DB_PASSWORD=vaulter
DB_EXTERNAL_PORT=5432

# pgAdmin no host
PGADMIN_PORT=8080

# AWS local (LocalStack, serviço "aws" do compose) — por enquanto só S3.
# Dentro dos containers o endpoint é http://aws:4566; do host, use localhost:AWS_EXTERNAL_PORT.
# LocalStack aceita qualquer credencial; "test" é a convenção. Use path-style (o host "aws" não resolve subdomínios).
AWS_ENDPOINT_URL=http://aws:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
S3_BUCKET_HUB_BRAIN=vaulter-hub-brain
AWS_EXTERNAL_PORT=4566

# Papel de runtime do banco: a API conecta com este login (sem superusuário, sem BYPASSRLS, sem DELETE).
# Migrations, CLI e testes usam DB_USERNAME (o dono). Criado por .docker/postgres/init/02-app-role.sh.
DB_APP_USERNAME=vaulter_app
DB_APP_PASSWORD=vaulter_app
# Banco dos testes e2e (padrão: ${DB_DATABASE}_test). Criado e migrado pelo globalSetup.
DB_TEST_DATABASE=vaulter_test

# Erros, documentação e logs
PROBLEM_TYPE_BASE_URL=https://errors.example.invalid
API_DOCS_TITLE=API
API_DOCS_INTERNAL_ENABLED=true
LOG_LEVEL=info
LOG_PRETTY=true

# Sentry (desligado sem DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Autenticação — os dois segredos abaixo são só desenvolvimento (32 bytes em base64url).
# Gerar outro: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=http://localhost:3000
AUTH_JWT_KEY_ID=dev-1
AUTH_JWT_SIGNING_SEED=DyJ5Qgh18loTHsaG3Xr_J8FWtyiB5h2QtAlxTEZa-Qw
# Rotação: chaves antigas só para verificar, kid:seed[,kid:seed...] (vazio = nenhuma)
# Sem espaços em nenhum ponto do valor (um espaço invalida a variável).
AUTH_JWT_PREVIOUS_KEYS=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_IDLE_DAYS=30
IDENTITY_DECOY_SALT_KEY=orQBLtekkdx5hOjMTASyIPM6gLj3f41B8JTi21M4EMg

# Proxy reverso confiável: false | true | nº de saltos | lista de IPs/CIDRs (separados por vírgula).
# Define se X-Forwarded-For vale como IP do cliente; só ligar atrás de um proxy conhecido.
TRUST_PROXY=false

# Threads do pool do Argon2id (opcional, inteiro >= 1). Vazio = min(4, núcleos disponíveis).
ARGON2_POOL_SIZE=
