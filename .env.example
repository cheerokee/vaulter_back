# Copie para .env e ajuste. O .env não é versionado.

# Porta da API no host (docker-compose). Dentro do container a API sempre escuta na 3000.
API_PORT=3000

# PostgreSQL 18 + pgvector (serviço "db" do compose)
# Dentro dos containers o host é "db" na porta 5432; do host, use localhost:DB_EXTERNAL_PORT.
DB_HOST=db
DB_PORT=5432
DB_DATABASE=vaulter
DB_USERNAME=vaulter
DB_PASSWORD=vaulter
DB_EXTERNAL_PORT=5432

# pgAdmin no host
PGADMIN_PORT=8080

# AWS local (LocalStack, serviço "aws" do compose) — S3 e KMS.
# Dentro dos containers o endpoint é http://aws:4566; do host, use localhost:AWS_EXTERNAL_PORT.
# LocalStack aceita qualquer credencial; "test" é a convenção. Use path-style (o host "aws" não resolve subdomínios).
# Validadas na subida (src/shared/infra/config/env.validation.ts):
# - AWS_REGION e S3_BUCKET_HUB_BRAIN: obrigatórias (bucket versionado, com as regras de ciclo de vida de
#   .docker/localstack/init/ready.d/01-buckets.sh — em produção, as mesmas regras);
# - AWS_ENDPOINT_URL: opcional; vazio em produção (o SDK resolve o endpoint da AWS);
# - AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: as duas ou nenhuma; vazias em produção (credenciais do papel IAM);
# - S3_FORCE_PATH_STYLE: true/false (padrão false); true para o LocalStack.
# As URLs assinadas saem com o host de AWS_ENDPOINT_URL: http://aws:4566 só resolve dentro do Docker.
AWS_ENDPOINT_URL=http://aws:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_FORCE_PATH_STYLE=true
S3_BUCKET_HUB_BRAIN=vaulter-hub-brain
AWS_EXTERNAL_PORT=4566

# Chave KMS que envelopa a privada X25519 do servidor (módulo cloud, nuvem ativa). Obrigatória. Em dev, o alias da
# chave criada por .docker/localstack/init/ready.d/02-kms.sh (id e material fixos, só de desenvolvimento); em produção,
# o alias de uma chave KMS simétrica real com rotação automática, e o papel IAM da API com kms:Encrypt e kms:Decrypt.
CLOUD_KMS_KEY_ID=alias/cloud-server-key

# Embeddings da nuvem ativa (serviço "embeddings" do compose: Ollama fixado, mesmo nomic-embed-text do Hub, 768 dim).
# Do host: http://localhost:EMBEDDINGS_EXTERNAL_PORT. O modelo (tag fixada) é baixado na primeira subida (~274 MB).
EMBEDDINGS_URL=http://embeddings:11434
EMBEDDINGS_EXTERNAL_PORT=11434
EMBEDDING_MODEL=nomic-embed-text:v1.5

# Modelo de linguagem da nuvem ativa. `bedrock` = Claude no Amazon Bedrock (us-east-1; em produção, papel IAM, sem chave
# extra; em dev, só com credenciais AWS reais no ambiente: as chaves "test" do LocalStack não servem). `fake` = respostas
# canned, para desenvolver sem acesso ao Bedrock. O id precisa ter preço em src/cloud/domain/ai-pricing.ts.
CLOUD_LLM_DRIVER=fake
CLOUD_LLM_MODEL_ID=us.anthropic.claude-sonnet-5-5

# Tarefas em segundo plano (pg-boss, schema próprio "pgboss", login de runtime). false = este processo só enfileira
# (sem workers, manutenção nem cron); os e2e rodam com false e um teste liga quando precisa. Padrão true.
JOB_WORKERS_ENABLED=true

# Papel de runtime do banco: a API conecta com este login (sem superusuário, sem BYPASSRLS, sem DELETE).
# Migrations, CLI e testes usam DB_USERNAME (o dono). Criado por .docker/postgres/init/02-app-role.sh.
DB_APP_USERNAME=vaulter_app
DB_APP_PASSWORD=vaulter_app
# Banco dos testes e2e (padrão: ${DB_DATABASE}_test). Criado e migrado pelo globalSetup.
DB_TEST_DATABASE=vaulter_test

# Erros, documentação e logs
PROBLEM_TYPE_BASE_URL=https://errors.example.invalid
API_DOCS_TITLE=API
API_DOCS_INTERNAL_ENABLED=true
LOG_LEVEL=info
LOG_PRETTY=true

# Sentry (desligado sem DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Autenticação — os dois segredos abaixo são só desenvolvimento (32 bytes em base64url).
# Gerar outro: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_JWT_ISSUER=http://localhost:3000
AUTH_JWT_AUDIENCE=http://localhost:3000
AUTH_JWT_KEY_ID=dev-1
AUTH_JWT_SIGNING_SEED=DyJ5Qgh18loTHsaG3Xr_J8FWtyiB5h2QtAlxTEZa-Qw
# Rotação: chaves antigas só para verificar, kid:seed[,kid:seed...] (vazio = nenhuma)
# Sem espaços em nenhum ponto do valor (um espaço invalida a variável).
AUTH_JWT_PREVIOUS_KEYS=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_IDLE_DAYS=30
IDENTITY_DECOY_SALT_KEY=orQBLtekkdx5hOjMTASyIPM6gLj3f41B8JTi21M4EMg
# Chave do hash dos códigos/desafios do Hub (32 bytes base64url) — segredo; este valor é só de desenvolvimento.
HUB_CODE_HASH_KEY=QWkJvAtiXvb3Ksle2ak8r546k2CzI5npol_AGPw0CwE
# Chave do hash da prova do código de recuperação da conta (32 bytes base64url) — segredo; este valor é só de
# desenvolvimento. Trocar invalida todos os códigos de recuperação já emitidos.
IDENTITY_RECOVERY_HASH_KEY=9BN2Eg-9OzfJm-jt-_1CIwvZwO3iMkSDSTY2HjSKsew

# Proxy reverso confiável: false | true | nº de saltos | lista de IPs/CIDRs (separados por vírgula).
# Define se X-Forwarded-For vale como IP do cliente.
# ATRÁS DE LOAD BALANCER/PROXY É OBRIGATÓRIO: nº de saltos (ex.: 1) ou os CIDRs do proxy.
# `false` atrás de LB faz todos os clientes dividirem um IP (limites por IP viram globais; login 10/min p/ todos).
# `true` / 0.0.0.0/0 confiam em X-Forwarded-For forjável (burla limites, falsifica lastIp): nunca em produção.
TRUST_PROXY=false

# Rate limit das rotas de autenticação (contadores no Postgres). Desligar só em desenvolvimento/testes.
RATE_LIMIT_ENABLED=true

# Threads do pool do Argon2id (opcional, inteiro >= 1). Vazio = min(4, núcleos disponíveis).
ARGON2_POOL_SIZE=

# Fila máxima do pool do Argon2id (opcional, inteiro >= 1). Vazio = threads x 64; cheia, a API responde 503.
ARGON2_MAX_QUEUE=
